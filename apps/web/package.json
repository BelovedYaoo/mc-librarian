{
  "name": "@mc-librarian/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "mc-librarian 前端：React 19 + Vite + MUI 9（源自 minimal-vite-ts）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "fm:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "gen:api": "openapi-typescript ../../docs/openapi.yaml -o src/types/api.d.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.0.12"
  }
}
