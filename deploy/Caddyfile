# web 容器里只跑 HTTP：TLS 与证书在边缘节点的 gateway-nginx 上终止（D15/D18）。
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# 前端只认 `/api` 前缀（apps/web/vite.config.ts 的 dev/preview 代理同构），
	# 转发前把前缀剥掉：`/api/v1/health` → api 容器的 `/v1/health`。
	handle_path /api/* {
		reverse_proxy api:8787 {
			# SSE：不要让 Caddy 攒内容，否则 /api/v1/ask 的增量事件会被延迟。
			flush_interval -1
		}
	}

	# 公开 API 表面：契约（docs/openapi.yaml）里的 servers 是根域名，
	# 所以 `/v1/*` 必须原样转发到 api，不能落进下面的 SPA 回退。
	handle /v1/* {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	# MCP 端点（streamable HTTP）：`/mcp` 与 `/mcp/` 都要原样转发。
	# 它也是长连接（GET 方向是 SSE 事件流），同样不能攒内容。
	handle /mcp* {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	# 其余走静态站点；react-router 的前端路由（/login、/browse…）回退到 index.html。
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
